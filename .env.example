# ─── Takeat OS (server-to-server — NUNCA usar prefixo NEXT_PUBLIC_) ────────────────────────────
TAKEAT_OS_URL=https://takeatos.vercel.app
AGENDA_DO_DIA_TOKEN=
AGENDA_EVENTOS_TOKEN=

# Segredo para cifrar os links de remarcar/cancelar (mín. 32 caracteres; gere com `openssl rand -hex 32`).
# Trocar este valor invalida todos os links já enviados.
AGENDA_LINK_SECRET=

# URL pública deste site (usada nos links de remarcar/cancelar do convite).
AGENDA_URL_PUBLICA=https://agenda.takeat.app

# ─── Quem recebe reuniões do site ──────────────────────────────────────────────────────────────
# E-mails (ou nomes) do Inside Sales que entram na roleta, separados por vírgula. Vazio = todos com
# agenda confiável. Recomendado: só quem conectou a agenda COM permissão de criar eventos.
AGENDA_VENDEDORES=

# ─── Regras de agenda (todas opcionais; os valores abaixo são o padrão) ─────────────────────────
AGENDA_EXPEDIENTE=09:00-18:00
AGENDA_ALMOCO=12:00-13:00
AGENDA_DIAS_DA_SEMANA=1,2,3,4,5
AGENDA_DURACAO_MIN=30
AGENDA_PASSO_MIN=30
AGENDA_BUFFER_MIN=10
AGENDA_ANTECEDENCIA_MIN=120
AGENDA_JANELA_DIAS_UTEIS=14
# Feriados locais/pontos facultativos além dos nacionais (AAAA-MM-DD, separados por vírgula).
AGENDA_FERIADOS_EXTRAS=
AGENDA_TITULO=Demo Takeat

# ─── Embed ─────────────────────────────────────────────────────────────────────────────────────
# Origens extras autorizadas a colocar a agenda em <iframe> (takeat.app e *.takeat.app já entram).
AGENDA_EMBED_ORIGENS=

# ─── Webhook opcional (ex.: n8n → HubSpot) ─────────────────────────────────────────────────────
# Recebe reuniao.agendada / reuniao.remarcada / reuniao.cancelada com lead, vendedor, UTM e motivo.
AGENDA_WEBHOOK_URL=
AGENDA_WEBHOOK_SECRET=
